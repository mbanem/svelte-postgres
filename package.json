{
  "name": "svelte-postgres",
  "version": "0.0.1",
  "private": true,
  "prettier": {
    "singleQuote": true
  },
  "scripts": {
    "dev": "clear; vite dev",
    "remove": "rm -R node_modules pnpm-lock.yaml; clear; pnpm i; pnpm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/enhanced-img": "^0.4.1",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "4.0.0-next.8",
    "@types/bcrypt": "^5.0.2",
    "@types/eslint": "9.6.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.46.0",
    "flowbite-svelte": "^0.47.3",
    "postcss": "^8.4.48",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.7",
    "sass": "^1.80.6",
    "sass-math": "^1.0.0",
    "svelte": "5.0.0-next.260",
    "svelte-check": "^4.0.6",
    "svelte-preprocess": "^6.0.3",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-sass-dts": "^1.3.29"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/fira-code": "^5.1.0",
    "@fortawesome/fontawesome-free": "^6.6.0",
    "@prisma/client": "^5.22.0",
    "@svelte-plugins/tooltips": "^3.0.1",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^5.1.1",
    "flowbite": "^2.5.2",
    "gsap": "^3.12.5",
    "prisma": "^5.22.0",
    "svelte-multiselect": "^10.3.0",
    "uuid": "^11.0.3"
  }
}
