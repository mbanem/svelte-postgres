    "@types/eslint": "9.6.1",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-svelte": "^3.5.1",
    "flowbite-svelte": "^0.48.6",
    "postcss": "^8.5.3",
    "postcss-load-config": "^6.0.1",
