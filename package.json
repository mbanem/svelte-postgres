    "@prisma/client": "^6.1.0",
    "@svelte-plugins/tooltips": "^3.0.1",
    "@types/uuid": "^10.0.0",
    "are-we-there-yet": "^4.0.2",
    "bcrypt": "^5.1.1",
    "flowbite": "^2.5.2",
    "gsap": "^3.12.5",
