{
  "name": "svelte-postgres",
  "version": "0.0.1",
  "private": true,
  "prettier": {
    "singleQuote": true
  },
  "scripts": {
    "dev": "clear; vite dev",
    "remove": "rm -R node_modules pnpm-lock.yaml; clear; pnpm i; pnpm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "clear; svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@prisma/client": "^6.16.2",
    "@sveltejs/adapter-auto": "^6.1.0",
    "@sveltejs/enhanced-img": "^0.8.2",
    "@sveltejs/kit": "^2.43.5",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/eslint": "9.6.1",
    "@types/node": "^24.7.2",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.12.4",
    "postcss": "^8.5.6",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "prisma": "^6.16.2",
    "sass": "^1.93.2",
    "sass-math": "^1.0.0",
    "svelte": "5.41.1",
    "svelte-check": "^4.3.2",
    "svelte-preprocess": "^6.0.3",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "vite": "^6.0.0",
    "vite-plugin-sass-dts": "^1.3.31"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/fira-code": "^5.2.7",
    "@fortawesome/fontawesome-free": "^7.0.1",
    "@svelte-plugins/tooltips": "^3.0.3",
    "@types/uuid": "^11.0.0",
    "are-we-there-yet": "^4.0.2",
    "bcrypt": "^6.0.0",
    "gsap": "^3.13.0",
    "svelte-multiselect": "^11.2.3",
    "sveltekit-superforms": "^2.27.1",
    "uuid": "^13.0.0",
    "zod": "^4.1.11"
  },
  "cspell": {
    "version": "0.2",
    "ignorePaths": [],
    "dictionaryDefinitions": [],
    "dictionaries": [],
    "words": [],
    "ignoreWords": [],
    "import": []
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma",
      "sharp",
      "svelte-preprocess"
    ]
  }
}
