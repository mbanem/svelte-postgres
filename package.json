  "version": "0.0.1",
  "private": true,
  "prettier": {
    "singleQuote": true
  },
  "scripts": {
    "dev": "clear; vite dev",
    "remove": "rm -R node_modules pnpm-lock.yaml; clear; pnpm i; pnpm run dev",
