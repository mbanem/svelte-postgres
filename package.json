{
  "name": "svelte-postgres",
  "version": "0.0.1",
  "private": true,
  "prettier": {
    "singleQuote": true
  },
  "scripts": {
    "dev": "clear; vite dev",
    "remove": "rm -R node_modules pnpm-lock.yaml; clear; pnpm i; pnpm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "clear; svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
