{
  "editor.fontFamily": "'Fira Code', Consolas,'Courier New',monospace",
  "editor.fontLigatures": true,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.tgz": true,
    "README.md": true,
    "scss.validate": true,
    "node_modules": true,
    "pnpm-lock.yaml": true,
    ".svelte-kit": true,
    "src/styles/app.css": true,
    "src/styles/mixins.css": true,
    "src/styles/mixins.css.map": true,
    "src/styles/variables.css": true,
    "src/styles/variables.css.map": true,
    "src/styles/app.css.map": true
  },
  "hide-files.files": [
    "node_modules",
    "pnpm-lock.yaml",
    ".svelte-kit",
    "src/styles/app.css",
    "src/styles/mixins.css",
    "src/styles/mixins.css.map",
    "src/styles/variables.css",
    "src/styles/variables.css.map",
    "src/styles/app.css.map"
  ],
  // generating a print statement of the current word on the next line, in different languages
  "multiCommand.commands": [
    {
      "command": "multiCommand.jsGeneratePrint",
      "sequence": [
        "editor.action.addSelectionToNextFindMatch",
        "editor.action.clipboardCopyAction",
        "editor.action.insertLineAfter",
        {
          "command": "editor.action.insertSnippet",
          "args": {
            "snippet": "console.log(\"$CLIPBOARD: \", $CLIPBOARD);"
          }
        }
      ]
    },
    {
      "command": "multiCommand.javaGeneratePrint",
      "sequence": [
        "editor.action.addSelectionToNextFindMatch",
        "editor.action.clipboardCopyAction",
        "editor.action.insertLineAfter",
        {
          "command": "editor.action.insertSnippet",
          "args": {
            "snippet": "System.out.println(\"$CLIPBOARD: \" + $CLIPBOARD);"
          }
        }
      ]
    }
  ],
  "indentRainbow.includedLanguages": ["html"],
  "indentRainbow.indicatorStyle": "light",
  "indentRainbow.lightIndicatorStyleLineWidth": 1,
  "indentRainbow.colors": [
    "rgba(255, 255, 64, 0.81)",
    "rgba(91, 235, 91, 0.3)",
    "rgba(216, 111, 216, 0.3)",
    "rgba(105, 218, 218, 0.3)"
  ],
  "editor.guides.indentation": true,
  "editor.guides.bracketPairs": "active",
  "todohighlight.isEnable": true,
  "todohighlight.isCaseSensitive": true,
  "todohighlight.keywords": [
    {
      "text": "Todo",
      "color": "white",
      "backgroundColor": "#2ecc71",
      "border": "1px solid #27ae60",
      "borderRadius": "4px",
      "isWholeLine": false
    }
  ],
  "todohighlight.include": ["**/*.ts", "**/*.tsx", "**/*.svelte"],
  "todohighlight.exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.vscode/**",
    "**/.next/**",
    "**/*.min.*",
    "**/*.map"
  ],
  "todohighlight.keywordsPattern": "Todo.*",
  "todohighlight.defaultStyle": {
    "color": "#ffffff",
    "backgroundColor": "#ff4500",
    "overviewRulerColor": "#ffab00",
    "isWholeLine": false
  }
}
